# Setup lokal (Node.js 24+, XAMPP):
# 1. Nyalakan Apache dan MySQL di XAMPP. Buka http://localhost/phpmyadmin/.
# 2. Buat database lofo (utf8mb4_unicode_ci), pilih database itu, lalu impor backend/schema.sql.
# 3. Dari tab SQL sebagai admin database, buat akun aplikasi dengan kata sandi unik:
#    CREATE USER 'lofo_app'@'127.0.0.1' IDENTIFIED BY '<ganti-dengan-kata-sandi-unik>';
#    GRANT SELECT ON lofo.reports TO 'lofo_app'@'127.0.0.1';
# 4. Salin file ini ke .env dan isi DB_PASSWORD. Jangan commit .env.
# 5. Jalankan npm ci, lalu npm start dari root repo. Buka http://127.0.0.1:3000/.
#    Cek /api/reports: HTTP 200 dengan {"reports":[]} pada database baru.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lofo
DB_USER=lofo_app
DB_PASSWORD=
